---
import Base from '../layouts/Base.astro';
import { SITE_NAME } from 'astro:env/server';
import YinampSpectrum from '../components/YinampSpectrum.astro';

const links = [
  { label: 'GitHub', href: 'https://github.com/KutnerUri' },
  { label: 'Medium', href: 'https://medium.com/@urikutner' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/kutner-works' },
];

const articles = [
  { year: 2026, title: 'The Processed Food Score', href: 'https://medium.com/@urikutner/the-processed-food-score-00802a8f6c98' },
  { year: 2026, title: 'Simply explaining the Weak Force', href: 'https://medium.com/@urikutner/simply-explaining-the-weak-force-965dc9e49313' },
  { year: 2023, title: 'The complete and simple guide to interactive element states', href: 'https://medium.com/@urikutner/the-complete-and-simple-guide-to-interactive-element-states-8c456b1aac17' },
  { year: 2023, title: 'Powerful design with Priority & Intent', href: 'https://medium.com/@urikutner/powerful-design-with-priority-intent-39b3e04b7c6d' },
  { year: 2023, title: 'The new JS-in-CSS', href: 'https://medium.com/@urikutner/the-new-js-in-css-5fd9908a48ea' },
  { year: 2023, title: 'Challenging AI to write an Apple Watch app to help quit smoking', href: 'https://medium.com/@urikutner/challenging-ai-to-write-an-apple-watch-8-app-to-help-quit-smoking-f3e681e5ac89' },
  { year: 2019, title: 'Reusing JavaScript tests', href: 'https://medium.com/bitsrc/reusing-javascript-tests-483288d3f733' },
  { year: 2019, title: 'The Vanilla and Flavouring pattern', href: 'https://medium.com/bitsrc/the-vanilla-and-flavouring-pattern-fcf07942a57a' },
];
---

<Base
  description="Uri Kutner makes web experiences, and the code factories that build them. Projects, writing and 14 years of frontend leadership."
  themeColor="#07080d"
>
<header class="intro">
  <h1>{SITE_NAME}</h1>
  <p class="lede">I make web experiences, and the code factories that build them.</p>
  <p>
    I've spent over 14 years building software, most of it leading frontend and web work:
    architectures people can follow, guides people actually use, and a good collection of
    lessons from the ones that didn't.
  </p>
  <p>I've built design systems, live component previews, and the tools around them.</p>
  <p>This is where I keep the things I make, and what I learn making them.</p>
  <ul class="links">
    {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
  </ul>
</header>

<main>
  <section aria-labelledby="made">
    <h2 class="section-title" id="made">Things I made</h2>
    <div class="projects">
      <a class="retro" href="https://retrograde.nefzen.dev/">
        <svg viewBox="0 0 200 200" aria-hidden="true">
          <g fill="none" stroke="#34374d"><circle cx="100" cy="100" r="36"/><circle cx="100" cy="100" r="62"/><circle cx="100" cy="100" r="92"/></g>
          <circle cx="100" cy="100" r="11" fill="#f4eedc"/>
          <g class="spin"><circle cx="131" cy="82" r="5" fill="#2f74e0"/></g>
          <g class="spin b"><circle cx="56" cy="56" r="4" fill="#e8412f"/></g>
          <g class="spin c"><circle cx="165" cy="35" r="7.5" fill="#efb27a"/></g>
        </svg>
        <div>
          <h3>Retrograde Tracker</h3>
          <p>Which planets are retrograde, and when.</p>
        </div>
      </a>
      <a class="philo" href="https://philo.nefzen.dev/">
        <svg viewBox="0 0 200 200" aria-hidden="true" fill="none" stroke-width="4">
          <path d="M60 10V190" stroke="#2f5d8a"/>
          <path d="M60 55L90 85V190" stroke="#3d8a5f"/>
          <path d="M90 105L120 135V190" stroke="#b5850f"/>
          <g fill="#faf9f6"><g stroke="#2f5d8a"><circle cx="60" cy="25" r="7"/><circle cx="60" cy="125" r="7"/></g><circle cx="90" cy="92" r="7" stroke="#3d8a5f"/><circle cx="120" cy="150" r="7" stroke="#b5850f"/></g>
          <path d="M76 25H150M106 92H165M136 150H175" stroke="#d3cec2" stroke-width="2"/>
        </svg>
        <div>
          <h3>Greek Philosophers</h3>
          <p>Who taught whom in Greece.</p>
        </div>
      </a>
      <a class="yinamp" href="https://yinamp.nefzen.dev/">
        <div class="lcd"><YinampSpectrum /></div>
        <div>
          <h3>Yinamp</h3>
          <p>Winamp-style player for YouTube.</p>
        </div>
      </a>
    </div>
    <div class="soon">
      <div class="sing"><h3>Countdown to the Singularity</h3><p>Coming soon</p></div>
      <div class="body"><h3>Body Simulator</h3><p>Coming soon</p></div>
      <div class="nosmoke"><h3>No Smoke</h3><p>Small promises to quit smoking.</p><p>Coming soon</p></div>
      <div class="mana"><h3>Mana Therapy</h3><p>Life as a resource game.</p><p>Coming soon</p></div>
    </div>
  </section>

  <section class="writing" aria-labelledby="articles">
    <h2 class="section-title" id="articles">Articles</h2>
    <ul>
      {articles.map((article) => (
        <li>
          <a href={article.href}>{article.title}</a>
          <span>{article.year}</span>
        </li>
      ))}
    </ul>
    <p><a href="https://medium.com/@urikutner">Everything on Medium →</a></p>
  </section>
</main>

<footer>
  <p>
    Online I go by nefzen, after Fizban from Dragonlance, who turns up under a different name in
    every story. And yes, I'm a Pisces, which might explain the retrograde tracker.
  </p>
</footer>
</Base>

<style is:global>
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  min-height: 100vh; min-height: 100svh;
  background: #07080d; color: #ecebf5;
  font: 1rem/1.6 system-ui, sans-serif;
}
a { color: inherit; }
a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
ul { list-style: none; }

.intro { max-width: 42rem; padding: 5rem 1.5rem 4rem; margin: 0 auto; }
.intro h1 { font-size: clamp(2.5rem, 7vw, 3.5rem); line-height: 1.05; letter-spacing: -.02em; }
.intro p { margin-top: 1rem; color: #b7b8cc; }
.intro .lede { margin-top: 1.25rem; font-size: 1.5rem; line-height: 1.35; color: #f4eedc; text-wrap: balance; }
.links { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: 2rem; }
.links a { font-weight: 600; text-underline-offset: .25em; }
.links a:hover { color: #f4eedc; }

.section-title {
  padding: 1rem 1.5rem; padding-left: max(1.5rem, (100% - 42rem) / 2 + 1.5rem); border-top: 1px solid #34374d;
  font-size: .8rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: #8b8da3;
}

.projects { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); }
.projects a {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 1.5rem; padding: 2.5rem 1.5rem; min-height: 20rem;
  text-align: center; text-decoration: none;
}
.projects a:focus-visible { outline-offset: -8px; }
.projects h3, .soon h3 { line-height: 1.1; font-weight: 700; }
.projects a:hover h3 { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .2em; }
.projects p, .soon p { max-width: 30ch; margin: .75rem auto 0; text-wrap: balance; }
.projects svg { display: block; width: min(15rem, 60vw); height: auto; }

.retro { background: radial-gradient(circle at 50% 35%, #10132a, #07080d 70%); }
.retro h3 { font-family: Didot, "Bodoni MT", "Playfair Display", Georgia, serif; font-size: 2.4rem; color: #f4eedc; }
.retro p { color: #b7b8cc; }
.spin { transform-origin: 100px 100px; animation: spin 24s linear infinite; }
.spin.b { animation-duration: 46s; }
.spin.c { animation-duration: 90s; }
@keyframes spin { to { transform: rotate(-360deg); } }

.yinamp { background: #14151e; font-family: ui-monospace, Menlo, Consolas, monospace; }
.yinamp h3 { font-size: 2.2rem; color: #a6f25c; }
.yinamp p { color: #c3c5d4; }
.lcd { padding: 1.5rem; background: #060d06; border: 3px solid; border-color: #23252f #555868 #555868 #23252f; }

.philo { background: #faf9f6; color: #1d1d1b; font-family: ui-serif, Georgia, serif; }
.philo h3 { font-size: 2.2rem; }
.philo p { color: #69665f; font-style: italic; }

.soon { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); grid-auto-rows: 1fr; margin-left: -1px; }
.soon > div { display: flex; flex-direction: column; justify-content: center; padding: 1.5rem; text-align: center; box-shadow: inset 1px 0 #34374d, inset 0 1px #34374d; }
.soon h3 { font-size: 1.3rem; }
.soon p { margin-top: .4rem; }
.sing { background: #0f1619; color: #ffbc78; }
.sing h3 { font-family: Georgia, serif; font-weight: 400; }
.sing p { color: #b1bfc4; }
.body { background: #fbf7f1; color: #1d1b19; }
.body p { color: #6b645c; }
.nosmoke { background: #fff4d1; color: #2b2b2b; }
.nosmoke p { color: #6b6150; }
.mana { background: #081226 linear-gradient(90deg, #ff3d49 20%, #a2c7ff 20% 40%, #63c96b 40% 60%, #e6d35c 60% 80%, #9a5dff 80%) top / 100% 4px no-repeat; color: #eaf3ff; }
.mana p { color: #9fb0cc; }

.writing ul, .writing > p { max-width: 42rem; margin: 0 auto; padding: 0 1.5rem; }
.writing ul { padding-top: 1rem; }
.writing li { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: .7rem 0; border-bottom: 1px solid #1c1e2b; }
.writing li a { text-decoration: none; }
.writing li a:hover { text-decoration: underline; text-underline-offset: .2em; }
.writing li span { flex: none; color: #6e7088; font: .85rem ui-monospace, Menlo, Consolas, monospace; }
.writing > p { padding-top: 1.25rem; padding-bottom: 4rem; }
.writing > p a { color: #b7b8cc; text-underline-offset: .25em; }

footer { border-top: 1px solid #34374d; padding: 2rem 1.5rem 3rem; }
footer p { max-width: 42rem; margin: 0 auto; color: #8b8da3; font-size: .9rem; }

@media (prefers-reduced-motion: reduce) { .spin { animation: none; } }
</style>
