---
import Base from '../layouts/Base.astro';
import { SITE_NAME } from 'astro:env/server';
---

<Base
  description="Small web projects: Retrograde Tracker, a map of which planets are retrograde now; a timeline of Greek philosophers; and Yinamp, a Winamp-inspired music player for YouTube."
  themeColor="#07080d"
>
<header><h1>{SITE_NAME}</h1></header>
<main>
  <a class="retro" href="https://retrograde.nefzen.dev/">
    <svg viewBox="0 0 200 200" aria-hidden="true">
      <g fill="none" stroke="#34374d"><circle cx="100" cy="100" r="36"/><circle cx="100" cy="100" r="62"/><circle cx="100" cy="100" r="92"/></g>
      <circle cx="100" cy="100" r="11" fill="#f4eedc"/>
      <g class="spin"><circle cx="131" cy="82" r="5" fill="#2f74e0"/></g>
      <g class="spin b"><circle cx="56" cy="56" r="4" fill="#e8412f"/></g>
      <g class="spin c"><circle cx="165" cy="35" r="7.5" fill="#efb27a"/></g>
    </svg>
    <div>
      <h2>Retrograde Tracker</h2>
      <p>Which planets are retrograde, when, and for how long.</p>
    </div>
  </a>
  <a class="philo" href="https://philo.nefzen.dev/">
    <svg viewBox="0 0 200 200" aria-hidden="true" fill="none" stroke-width="4">
      <path d="M60 10V190" stroke="#2f5d8a"/>
      <path d="M60 55L90 85V190" stroke="#3d8a5f"/>
      <path d="M90 105L120 135V190" stroke="#b5850f"/>
      <g fill="#faf9f6"><g stroke="#2f5d8a"><circle cx="60" cy="25" r="7"/><circle cx="60" cy="125" r="7"/></g><circle cx="90" cy="92" r="7" stroke="#3d8a5f"/><circle cx="120" cy="150" r="7" stroke="#b5850f"/></g>
      <path d="M76 25H150M106 92H165M136 150H175" stroke="#d3cec2" stroke-width="2"/>
    </svg>
    <div>
      <h2>Greek Philosophers</h2>
      <p>Who taught whom, from Thales to Plotinus.</p>
    </div>
  </a>
  <a class="yinamp" href="https://yinamp.nefzen.dev/">
    <div class="lcd">
      <svg viewBox="0 0 200 120" aria-hidden="true" fill="#a6f25c">
        <rect class="bar" x="2" y="60" width="20" height="60"/>
        <rect class="bar" x="30" y="25" width="20" height="95" style="animation-delay:-.7s"/>
        <rect class="bar" x="58" y="45" width="20" height="75" style="animation-delay:-.3s"/>
        <rect class="bar" x="86" y="5" width="20" height="115" style="animation-delay:-1.4s"/>
        <rect class="bar" x="114" y="35" width="20" height="85" style="animation-delay:-.9s"/>
        <rect class="bar" x="142" y="55" width="20" height="65" style="animation-delay:-1.8s"/>
        <rect class="bar" x="170" y="80" width="20" height="40" style="animation-delay:-.5s"/>
      </svg>
    </div>
    <div>
      <h2>Yinamp</h2>
      <p>A free, Winamp-inspired music player for YouTube.</p>
    </div>
  </a>
</main>
<section class="soon" aria-label="Coming soon">
  <div class="sing"><h2>Countdown to the Singularity</h2><p>Coming soon</p></div>
  <div class="body"><h2>Body Simulator</h2><p>Coming soon</p></div>
</section>
</Base>

<style is:global>
* { box-sizing: border-box; margin: 0; }
body {
  min-height: 100vh; min-height: 100svh;
  display: flex; flex-direction: column;
  background: #07080d; color: #ecebf5;
  font: 1rem/1.5 system-ui, sans-serif;
}
header { padding: 1.1rem 1.5rem; border-bottom: 1px solid #34374d; }
h1 { font-size: 1rem; font-weight: 600; }
main { flex: 1; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); }
main a {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 1.5rem; padding: 2.5rem 1.5rem; min-height: 20rem;
  color: inherit; text-align: center; text-decoration: none;
}
a:focus-visible { outline: 2px solid currentColor; outline-offset: -8px; }
h2 { line-height: 1.1; font-weight: 700; }
a:hover h2 { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .2em; }
p { max-width: 30ch; margin: .75rem auto 0; text-wrap: balance; }
svg { display: block; width: min(15rem, 60vw); height: auto; }

.retro { background: radial-gradient(circle at 50% 35%, #10132a, #07080d 70%); }
.retro h2 { font-family: Didot, "Bodoni MT", "Playfair Display", Georgia, serif; font-size: 2.4rem; color: #f4eedc; }
.retro p { color: #b7b8cc; }
.spin { transform-origin: 100px 100px; animation: spin 24s linear infinite; }
.spin.b { animation-duration: 46s; }
.spin.c { animation-duration: 90s; }
@keyframes spin { to { transform: rotate(-360deg); } }

.yinamp { background: #14151e; font-family: ui-monospace, Menlo, Consolas, monospace; }
.yinamp h2 { font-size: 2.2rem; color: #a6f25c; }
.yinamp p { color: #c3c5d4; }
.lcd { padding: 1.5rem; background: #060d06; border: 3px solid; border-color: #23252f #555868 #555868 #23252f; }
.bar { transform-origin: 0 120px; animation: eq 1.1s ease-in-out infinite alternate; }
@keyframes eq { from { transform: scaleY(1); } to { transform: scaleY(.35); } }

.philo { background: #faf9f6; color: #1d1d1b; font-family: ui-serif, Georgia, serif; }
.philo h2 { font-size: 2.2rem; }
.philo p { color: #69665f; font-style: italic; }

.soon { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); border-top: 1px solid #34374d; }
.soon div { padding: 1.5rem; text-align: center; }
.soon h2 { font-size: 1.3rem; }
.soon p { margin-top: .4rem; }
.sing { background: #0f1619; color: #ffbc78; }
.sing h2 { font-family: Georgia, serif; font-weight: 400; }
.sing p { color: #b1bfc4; }
.body { background: #fbf7f1; color: #1d1b19; }
.body p { color: #6b645c; }

@media (prefers-reduced-motion: reduce) { .spin, .bar { animation: none; } }
</style>
